// corela_input.bosonoga
//
// The keys.

// A board in the history is board_values values from its number on: its cells,
// its region and its selected q and r. in_past_bool picks past or future.
def keep_value_fn in_past_bool slot_i32 value_i32 with from_global past future ret_void
di
  if in_past_bool
  di
    set past at slot_i32 to value_i32
  do
  else
  di
    set future at slot_i32 to value_i32
  do
do

def kept_value_fn in_past_bool slot_i32 with from_global past future ret 0_i32
di
  if in_past_bool
  di
    val value is past at slot_i32 with ret 0_i32
    return value
  do
  val value is future at slot_i32 with ret 0_i32
  return value
do

// Keeps the present board as board number_i32 of the past or the future.
def keep_board_fn in_past_bool number_i32 with from_global cells region selected_q selected_r ret_void
di
  var slot is number_i32
  set slot to_multiply board_values
  var index is 0_i32
  while index lt all_cells
  di
    val value is cells at index with ret 0_i32
    call keep_value_fn of in_past_bool slot value
    set slot to_add 1_i32
    set index to_add 1_i32
  do
  call keep_value_fn of in_past_bool slot region
  set slot to_add 1_i32
  call keep_value_fn of in_past_bool slot selected_q
  set slot to_add 1_i32
  call keep_value_fn of in_past_bool slot selected_r
do

// Makes board number_i32 of the past or the future the present board.
def restore_board_fn in_past_bool number_i32 with from_global cells region selected_q selected_r ret_void
di
  var slot is number_i32
  set slot to_multiply board_values
  var index is 0_i32
  while index lt all_cells
  di
    val value is kept_value_fn of in_past_bool slot with ret 0_i32
    set cells at index to value
    set slot to_add 1_i32
    set index to_add 1_i32
  do
  set region to kept_value_fn of in_past_bool slot with ret 0_i32
  set slot to_add 1_i32
  set selected_q to kept_value_fn of in_past_bool slot with ret 0_i32
  set slot to_add 1_i32
  set selected_r to kept_value_fn of in_past_bool slot with ret 0_i32
do

// Handles a key as corela's handle_key does. A command that succeeds is the
// next action, which an undo or a redo is too, and the last one ends the run.
gfx_key_down
di
  set any_key_pressed to true_bool
  val last is global_replay_last_action
  val shown is math_to_min action last
  var next_action is action
  set next_action to_add 1_i32
  val shown_next is math_to_min next_action last
  var command is nihil_i32
  var dq is 0_i32
  var dr is 0_i32
  // Keys do nothing while the run closes, plays, saves or loads, and only
  // key_cycle leaves mode_none.
  if closing or playback_count gt 0_i32 or save_requested or load_requested
  or mode eq mode_none and gfx_key not_eq key_cycle
  di
    nihil
  do
  else if gfx_key eq key_theme
  di
    if dark
    di
      set dark to false_bool
      info "core: action_"_str shown "_of_"_str last ": light_theme"_str
    do
    else
    di
      set dark to true_bool
      info "core: action_"_str shown "_of_"_str last ": dark_theme"_str
    do
  do
  else if gfx_key eq key_escape
  di
    set mode to mode_none
    info "core: action_"_str shown "_of_"_str last ": input_mode_none"_str
  do
  else if gfx_key eq key_cycle
  di
    set mode to_add 1_i32
    set mode to_mod mode_count
    val code is mode_codes at mode with ret 0_str
    info "core: action_"_str shown "_of_"_str last ": input_mode_"_str code
  do
  else if gfx_key eq key_run
  di
    if mode eq mode_undo and action le last
    di
      set command to_optional_i32 command_undo
    do
    else if mode eq mode_redo and action le last
    di
      set command to_optional_i32 command_redo
    do
    else if mode eq mode_save
    di
      if action eq 1_i32
      di
        info "core: action_"_str shown "_of_"_str last ": nothing_to_save"_str
      do
      else
      di
        set save_requested to true_bool
      do
    do
    else if mode eq mode_load
    di
      set load_requested to true_bool
    do
  do
  else if mode eq mode_input and action le last
  di
    if gfx_key eq key_start
    di
      set command to_optional_i32 command_start
    do
    else if gfx_key eq key_arrow
    di
      set command to_optional_i32 command_arrow
    do
    else if gfx_key eq key_remove
    di
      set command to_optional_i32 command_remove
    do
    else if gfx_key eq key_north
    di
      set command to_optional_i32 command_move
      set dr to -1_i32
    do
    else if gfx_key eq key_south
    di
      set command to_optional_i32 command_move
      set dr to 1_i32
    do
    else if gfx_key eq key_north_east
    di
      set command to_optional_i32 command_move
      set dq to 1_i32
      set dr to -1_i32
    do
    else if gfx_key eq key_south_east
    di
      set command to_optional_i32 command_move
      set dq to 1_i32
    do
    else if gfx_key eq key_north_west
    di
      set command to_optional_i32 command_move
      set dq to -1_i32
    do
    else if gfx_key eq key_south_west
    di
      set command to_optional_i32 command_move
      set dq to -1_i32
      set dr to 1_i32
    do
  do

  // The note of a command that succeeds, which records it.
  var note is nihil_str
  if some command as chosen
  di
    if chosen eq command_undo
    di
      if past_count eq 0_i32
      di
        info "core: action_"_str shown "_of_"_str last ": nothing_to_undo"_str
      do
      else
      di
        call keep_board_fn of false_bool future_count
        set future_count to_add 1_i32
        set past_count to_subtract 1_i32
        call restore_board_fn of true_bool past_count
        var text is ""_str
        set text to_join "undo_"_str past_count "_more_to_undo_"_str future_count "_to_redo"_str
        set note to_optional_str text
      do
    do
    else if chosen eq command_redo
    di
      if future_count eq 0_i32
      di
        info "core: action_"_str shown "_of_"_str last ": nothing_to_redo"_str
      do
      else
      di
        call keep_board_fn of true_bool past_count
        set past_count to_add 1_i32
        set future_count to_subtract 1_i32
        call restore_board_fn of false_bool future_count
        var text is ""_str
        set text to_join "redo_"_str past_count "_to_undo_"_str future_count "_more_to_redo"_str
        set note to_optional_str text
      do
    do
    else
    di
      // The present board becomes the next one in the past, which counts only
      // if the edit succeeds.
      call keep_board_fn of true_bool past_count
      val q is selected_q
      val r is selected_r
      val here is cell_fn of region q r with ret 0_i32
      val node is cells at here with ret 0_i32
      if chosen eq command_move
      di
        if region eq center_region and q eq gate_q and r eq center_gate_r and dq eq 0_i32 and dr eq -1_i32
        di
          set region to north_region
          set selected_r to north_gate_r
          set note to "entered_north_region"_optional_str
        do
        else if region eq north_region and q eq gate_q and r eq north_gate_r and dq eq 0_i32 and dr eq 1_i32
        di
          set region to center_region
          set selected_r to center_gate_r
          set note to "entered_center_region"_optional_str
        do
        else
        di
          var to_q is q
          set to_q to_add dq
          var to_r is r
          set to_r to_add dr
          val inside is in_bounds_fn of to_q to_r with ret 0_bool
          if inside
          di
            set selected_q to to_q
            set selected_r to to_r
            var text is ""_str
            set text to_join "selected_"_str to_q "_"_str to_r
            set note to_optional_str text
          do
          else
          di
            info "core: action_"_str shown "_of_"_str last ": "_str to_q "_"_str to_r "_is_out_of_bounds"_str
          do
        do
      do
      else if chosen eq command_start
      di
        var has_start is false_bool
        var cell is 0_i32
        while cell lt all_cells
        di
          val held is cells at cell with ret 0_i32
          if held eq start_node
          di
            set has_start to true_bool
          do
          set cell to_add 1_i32
        do
        if node not_eq no_node
        di
          info "core: action_"_str shown "_of_"_str last ": "_str q "_"_str r "_is_taken_no_start_node"_str
        do
        else if has_start
        di
          info "core: action_"_str shown "_of_"_str last ": the_project_already_has_a_start_node"_str
        do
        else
        di
          set cells at here to start_node
          var text is ""_str
          set text to_join "placed_start_node_at_"_str q "_"_str r
          set note to_optional_str text
        do
      do
      else if chosen eq command_arrow
      di
        if node eq start_node
        di
          info "core: action_"_str shown "_of_"_str last ": "_str q "_"_str r "_holds_the_start_node_no_arrow"_str
        do
        else if node eq no_node
        di
          set cells at here to 1_i32
          var text is ""_str
          set text to_join "placed_arrow_at_"_str q "_"_str r
          set note to_optional_str text
        do
        else
        di
          // node is its direction and 1, so it is also the next direction.
          var turned is node
          set turned to_mod arrow_directions
          var stored is turned
          set stored to_add 1_i32
          set cells at here to stored
          var text is ""_str
          set text to_join "turned_arrow_at_"_str q "_"_str r "_to_"_str turned
          set note to_optional_str text
        do
      do
      else if chosen eq command_remove
      di
        if node eq no_node
        di
          info "core: action_"_str shown "_of_"_str last ": nothing_to_remove_at_"_str q "_"_str r
        do
        else
        di
          set cells at here to no_node
          var text is ""_str
          set text to_join "removed_node_at_"_str q "_"_str r
          set note to_optional_str text
        do
      do
      if some note
      di
        set past_count to_add 1_i32
        set future_count to 0_i32
      do
    do

    if some note as noted
    di
      info "core: action_"_str shown_next "_of_"_str last ": "_str noted
      var digits is ""_str
      var cell_index is 0_i32
      while cell_index lt all_cells
      di
        val cell_value is cells at cell_index with ret 0_i32
        set digits to_join digits cell_value
        set cell_index to_add 1_i32
      do
      xml_escape noted with ret 1_str as escaped_note
      di
        set replay_body to_join replay_body "<action number='"_str action "' command='"_str chosen
          "' dq='"_str dq "' dr='"_str dr "' region='"_str region "' q='"_str selected_q "' r='"_str selected_r
          "' undo='"_str past_count "' redo='"_str future_count "' note='"_str escaped_note "' cells='"_str digits "'/>"_str
      do
      set action to next_action
      if action gt last
      di
        set save_requested to true_bool
      do
    do
  do
do
