const mode_input is 1_i32
const mode_undo is 2_i32
const mode_redo is 3_i32
const mode_save is 4_i32
const mode_load is 5_i32
const mode_count is 6_i32
const no_command is 0_i32
const command_undo is 1_i32
const command_redo is 2_i32
const command_move is 3_i32
const command_start is 4_i32
const command_arrow is 5_i32
const command_remove is 6_i32

val mode_names is array 0_str
di
  row "None"_str
  row "Input"_str
  row "Undo"_str
  row "Redo"_str
  row "Save"_str
  row "Load"_str
do

